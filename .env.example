# Get a token at https://deepinfra.com/dash/api_keys
DEEPINFRA_TOKEN=your_deepinfra_token_here

# Optional overrides
# SHIM_PORT=8765
# STT model (default: Voxtral Mini)
DEEPINFRA_MODEL=mistralai/Voxtral-Mini-3B-2507
# Cleanup LLM (default: Gemma 4 E4B IT)
DEEPINFRA_CLEANUP_MODEL=google/gemma-4-E4B-it

# STT: trim leading/trailing silence only (mid pauses kept). 0/false to disable.
# TRIM_EDGE_SILENCE=1
# TRIM_SILENCE_PAD_SEC=0.25
# TRIM_SILENCE_DB=-50

# Cleanup system prompt the shim injects (replaces OpenWhispr stock system message).
# short (default) | minimal | stock (passthrough OpenWhispr prompt)
# CLEANUP_PROMPT_MODE=short

# Optional A/B bench (kept in code; off by default). ~2× cleanup cost when on.
# CLEANUP_BENCH=1
# CLEANUP_BENCH_RETURN=stock
